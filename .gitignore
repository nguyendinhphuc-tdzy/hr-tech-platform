# ===========================================
# HR Tech Platform - Root .gitignore
# ===========================================

# ===========================================
# ENVIRONMENT FILES (CRITICAL)
# ===========================================
# Never commit these files - they contain secrets!
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local

# Backend
backend/.env
backend/.env.local
backend/.env.development
backend/.env.production

# Frontend (Vite uses .env.local)
frontend/.env
frontend/.env.local
frontend/.env.production

# ===========================================
# LOGS
# ===========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ===========================================
# DEPENDENCIES
# ===========================================
node_modules/
jspm_packages/

# ===========================================
# BUILD OUTPUTS
# ===========================================
dist
dist-ssr
*.local
out/
.next/
.nuxt/

# ===========================================
# DEVELOPMENT FILES
# ===========================================
.vscode-test
.vscode/
.idea/
*.swp
*.swo
*~

# ===========================================
# TEST & COVERAGE
# ===========================================
coverage
*.lcov
.nyc_output/

# ===========================================
# BACKUP FILES
# ===========================================
*.bak
*.backup
backups/

# ===========================================
# OS FILES
# ===========================================
.DS_Store
Thumbs.db

# ===========================================
# SECURITY
# ===========================================
# SSL certificates
*.pem
*.key
*.crt

# ===========================================
# TEMPORARY FILES
# ===========================================
*.tmp
*.temp
.tmp/
temp/
